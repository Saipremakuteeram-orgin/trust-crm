PORT=8888

# Supabase (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_KEEP_SECRET

# ── Website -> CRM webhook secret ─────────────────────────────────────────────
# Shared secret the TRUST WEBSITE sends in the X-Trust-Webhook-Key header when
# it POSTs a new event. Generate one, e.g.:  openssl rand -hex 32
# Must match CRM_WEBHOOK_SECRET set in the website's environment (Vercel).
# CURRENT VALUE (generated 2026-08-31): 2ad2a205edfd3bf53d3c5a44605402201d04397bbdbf2d4d70dbd93135aedbab
# Paste the SAME value into Render (this var) and Vercel (CRM_WEBHOOK_SECRET).
WEBHOOK_SECRET=2ad2a205edfd3bf53d3c5a44605402201d04397bbdbf2d4d70dbd93135aedbab

# Gmail SMTP (App Password, not your normal password)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password

# Mail delivery (primary, HTTPS) — works on Render, which blocks outbound SMTP.
# Resend: https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=your_resend_api_key
# From address for outgoing mail; must be a sender verified in Resend.
# Example: Trust CRM <name@yourdomain.com>
MAIL_FROM=name@yourdomain.com

# --- Sender addresses on the verified domain: saidharmasamrakshanapremakuteeram.qzz.io ---
# mail@     -> RESEND_FROM_EMAIL: From for ALL automated CRM emails (automated, don't reply).
# info@     -> CONTACT_EMAIL: enquiry inbox. Shown as the footer "Contact Email" mailto link and
#              used as the Reply-To for all automated mail, so replies land here.
# subscribe@ -> reserved for the WEBSITE's event-notification pushes (same Resend account/API key).
#              Not used by this CRM; point the website project's event sends at it.
RESEND_FROM_EMAIL="mail@saidharmasamrakshanapremakuteeram.qzz.io"
RESEND_FROM_NAME="Sathya Sai Prema Kuteeram"
CONTACT_EMAIL=info@saidharmasamrakshanapremakuteeram.qzz.io
CONTACT_PHONE=+91-0000000000

# Branded email template (logo, address, auto-generated disclaimer footer).
# The footer logo is attached inline as cid:logo-footer (backend/assets/logo-footer.jpg),
# which Gmail/Outlook render inline automatically. TRUST_LOGO_URL overrides that with a
# hosted image URL if you prefer a remote image. Leave TRUST_LOGO_URL empty to use the inline CID logo.
TRUST_LOGO_URL=

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Google Drive (Service Account)
# 1. Go to console.cloud.google.com → Create project → Enable Google Drive API
# 2. Create Service Account → Generate JSON key → Download it
# 3. Create a folder in your Drive → Share it with the service account email
# 4. Paste the folder ID from the URL: https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="[REDACTED PRIVATE KEY]"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# Optional: paste the Common folder ID if you created it manually
# Otherwise it will be auto-created inside GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_COMMON_FOLDER_ID=

# --- WhatsApp Web Integration ---
# AES-256-GCM encryption key for per-user WhatsApp session files (64-char hex / 32 bytes)
# Generate with: openssl rand -hex 32
WA_SESSION_ENCRYPTION_KEY=your_64_char_hex_encryption_key_keep_secret
