PORT=8888

# Supabase (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_KEEP_SECRET

# Gmail SMTP (App Password, not your normal password)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password

# Mail delivery (primary, HTTPS) — works on Render, which blocks outbound SMTP.
# Resend: https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=your_resend_api_key
# From address for outgoing mail; must be a sender verified in Resend.
# Example: Trust CRM <name@yourdomain.com>
MAIL_FROM=name@yourdomain.com

# Branded email template (logo, address, auto-generated disclaimer footer).
# The footer logo is attached inline as cid:logo-footer (backend/assets/logo-footer.jpg),
# which Gmail/Outlook render inline automatically. TRUST_LOGO_URL overrides that with a
# hosted image URL if you prefer a remote image. CONTACT_* values appear in the footer.
# Leave TRUST_LOGO_URL empty to use the inline CID logo.
TRUST_LOGO_URL=
CONTACT_EMAIL=contact@yourdomain.com
CONTACT_PHONE=+91 0000000000

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Google Drive (Service Account)
# 1. Go to console.cloud.google.com → Create project → Enable Google Drive API
# 2. Create Service Account → Generate JSON key → Download it
# 3. Create a folder in your Drive → Share it with the service account email
# 4. Paste the folder ID from the URL: https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# Optional: paste the Common folder ID if you created it manually
# Otherwise it will be auto-created inside GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_COMMON_FOLDER_ID=
