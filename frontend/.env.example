VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_API_URL=http://localhost:8888/api

# Same-origin Tamil/English PaddleOCR.js recognition model archive. The app
# includes this model by default; override the path only for another host.
# The archive must be an uncompressed .tar containing inference.onnx and
# inference.yml with model_name: ta_PP-OCRv5_mobile_rec.
VITE_OCR_TAMIL_REC_MODEL_URL=/ocr-models/ta_PP-OCRv5_mobile_rec.tar

# For production (Vercel), set VITE_API_URL to your deployed backend:
# VITE_API_URL=https://trust-crm-b8rn.onrender.com/api

# Operations UI feature flags. Keep disabled until the staged rollout is approved.
# These are non-secret build-time flags; the API independently enforces its flags.
VITE_ENABLE_OPERATIONS_TRUSTS=false
VITE_ENABLE_OPERATIONS_DONATIONS_AUTOMATION=false
VITE_ENABLE_OPERATIONS_APPROVALS=false
VITE_ENABLE_OPERATIONS_FUNDS=false
VITE_ENABLE_OPERATIONS_INVOICES=false
VITE_ENABLE_OPERATIONS_PAYROLL=false
VITE_ENABLE_OPERATIONS_AUTOMATION_MONITOR=false

# Trust legal, branding, payment, sender-email, and statutory payroll values are
# deployment/database configuration, not frontend source or public build values.
